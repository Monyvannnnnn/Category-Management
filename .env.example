# Database Driver (mysql for local XAMPP, pgsql for Supabase PostgreSQL)
DB_DRIVER=pgsql

# Supabase PostgreSQL Credentials
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASS=YOUR_SUPABASE_PASSWORD

# Full Database Connection String
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_SUPABASE_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Local XAMPP MySQL Credentials (for local development)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASS=
MYSQL_NAME=inventory
